# Copy to .env.local and fill in before launch.

# Public URL of the site (used for SEO, sitemaps and share links)
NEXT_PUBLIC_SITE_URL=https://blackownedsheffield.co.uk

# Preview banner + sample listings/events. Set both to "false" once real content is in.
NEXT_PUBLIC_PREVIEW_MODE=true
NEXT_PUBLIC_SHOW_SAMPLES=true

# Sessions (members' Business Support area and the /admin dashboard)
# Generate a long random string, e.g.  openssl rand -base64 48
SESSION_SECRET=
# Code you send to approved members so they can open Business Support
MEMBER_ACCESS_CODE=
# Password for the team's /admin dashboard
ADMIN_PASSWORD=

# Optional: every form submission is also POSTed here as JSON.
# Point it at Zapier, Make, a Slack/Discord webhook, Google Apps Script, etc.
SUBMISSIONS_WEBHOOK_URL=

# Map tiles. The directory map uses CARTO's free Voyager basemap when this key
# is set (request one at https://carto.com/basemaps/apikey). Without it the map
# falls back to OpenStreetMap's standard tiles, which are fine for a preview
# but not meant for heavy production traffic.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=
# Or point at any other XYZ tile provider instead:
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
